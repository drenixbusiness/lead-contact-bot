# ---------- MONDAY ----------
MONDAY_TOKEN=
MONDAY_BOARD_ID=
# Monday'dagi ustun nomlari (aynan board'dagidek). `npm run inspect` hammasini ko'rsatadi.
COL_NUMBER=Number
COL_LEAD_NAME=            # bo'sh = item nomi
COL_ARRIVAL=              # bo'sh = item yaratilgan vaqt (created_at)
COL_ASSIGNED=Assigned Date
COL_LEAD_TYPE=Lead Type
COL_RECRUITER=Recruiter
COL_PLATFORM=Platform
COL_STATUS=Status
COL_DRIVER_TYPE=Driver Type

# ---------- RINGCENTRAL ----------
RC_SERVER=https://platform.ringcentral.com
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
# true = account darajasidagi call log (admin ruxsat kerak), false = faqat shu JWT extension
RC_ACCOUNT_WIDE=true
# SMS faqat JWT egasi extensioni bo'yicha sanaladi
RC_INCLUDE_SMS=true
# false = First/Last Contact faqat call bo'yicha; true = SMS ham hisoblanadi
RC_SMS_COUNTS_AS_CONTACT=false

# ---------- GOOGLE SHEETS ----------
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
SHEET_ID=
SHEET_TAB=Leads

# ---------- BOT ----------
TZ_NAME=America/Chicago
SINCE_HOURS=48            # oxirgi necha soatda kelgan leadlar
REFRESH_DAYS=7            # first contact bo'sh qolgan leadlarni necha kun qayta tekshirish
POLL_MINUTES=10           # --watch rejimida
